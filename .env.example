
# ==========================================
# BEBIDAMIX - CONFIGURACOES DE EXEMPLO
# ==========================================

# WHATSAPP
# Numero com codigo do pais e DDD, sem espacos
WHATSAPP_NUMERO=55DDDNÚMERO

# ==========================================
# MONGODB ATLAS
# ==========================================

# URI de conexao com o MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/

# Nome do banco de dados
MONGO_DB_NAME=BebidaMix

# ==========================================
# SUPABASE
# ==========================================

# URL do projeto Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave publica do projeto
SUPABASE_KEY=SUA_CHAVE_PUBLICA

# ==========================================
# FLASK
# ==========================================

# Gere uma chave secreta exclusiva
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE

# Ambiente de desenvolvimento
FLASK_ENV=development

# ==========================================
# REDIS
# ==========================================

# Utilizado se a configuracao Python ler REDIS_URL
REDIS_URL=redis://localhost:6379/0
